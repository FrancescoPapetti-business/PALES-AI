# OpenAI API key used by the RAG pipeline.
OPENAI_API_KEY=your_openai_api_key_here

# Optional API key for protecting backend endpoints.
# Leave empty for local development.
PALESAI_API_KEY=

# Comma-separated list of frontend origins allowed by the FastAPI backend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL for the chat endpoint.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/chat
